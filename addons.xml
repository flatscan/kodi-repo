<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="script.flatscan.widgets"
       name="Flatscan Widgets"
       version="1.0.0"
       provider-name="flatscan">

    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>

    <!-- Script interface (for skin calls) -->
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>

    <!-- Plugin interface (for widgets) -->
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>

    <!-- Service interface (for background tasks) -->
    <extension point="xbmc.service" library="service.py"/>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Widgets and skin helpers for Kodi</summary>
        <description lang="en_GB">Widget paths and skin helpers for Kodi skins: Next Up, in-progress and recently added media (grouped by show and season), recently aired and recently released, upcoming episodes from Sonarr, movie collections in progress, suggestions and similar items, path statistics, and background fanart rotation.</description>

        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://github.com/flatscan/flatscanwidgets</source>
        <forum>https://github.com/flatscan/flatscanwidgets/discussions</forum>

        <assets>
            <icon>resources/icon.png</icon>
        </assets>

        <news>v1.0.0 (2026-10-31)
- First release of Flatscan Widgets for Kodi 21 (Omega)
- Next Up, Recently Added Grouped, Recently Aired and Sonarr Upcoming Episodes widgets
- Movie widgets: Recently Released, Next in Collection, Collections in Progress
- Background service: fanart rotation, artwork pre-caching, widget refresh on library updates
        </news>
    </extension>
</addon>
<addon id="repository.flatscan"
       name="Flatscan Repository"
       version="1.0.0"
       provider-name="flatscan">

    <extension point="xbmc.addon.repository" name="Flatscan Repository">
        <dir>
            <info compressed="false">https://flatscan.github.io/kodi-repo/addons.xml</info>
            <checksum>https://flatscan.github.io/kodi-repo/addons.xml.md5</checksum>
            <datadir zip="true">https://flatscan.github.io/kodi-repo/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Flatscan add-ons for Kodi</summary>
        <description lang="en_GB">Install and update Flatscan add-ons, including Flatscan Widgets.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://github.com/flatscan/kodi-repo</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
