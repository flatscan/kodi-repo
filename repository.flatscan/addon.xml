<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.flatscan"
       name="Flatscan Repository"
       version="1.0.0"
       provider-name="flatscan">

    <extension point="xbmc.addon.repository" name="Flatscan Repository">
        <dir>
            <info compressed="false">https://flatscan.github.io/kodi-repo/addons.xml</info>
            <checksum>https://flatscan.github.io/kodi-repo/addons.xml.md5</checksum>
            <datadir zip="true">https://flatscan.github.io/kodi-repo/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Flatscan add-ons for Kodi</summary>
        <description lang="en_GB">Install and update Flatscan add-ons, including Flatscan Widgets.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <source>https://github.com/flatscan/kodi-repo</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
